{
  "name": "ontoreport",
  "version": "0.0.1",
  "description": "Quality report for OWL ontologies built from the project record",
  "homepage": "https://github.com/Minitour/ontoreport",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minitour/ontoreport.git"
  },
