@prefix : <http://example.org/env#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/env> a owl:Ontology .

:Feature a owl:Class ; rdfs:label "environmental feature" .
:WaterBody a owl:Class ; rdfs:label "water body" ; rdfs:subClassOf :Feature .
:Landform a owl:Class ; rdfs:label "landform" ; rdfs:subClassOf :Feature .
:Lake a owl:Class ; rdfs:label "lake" ; rdfs:subClassOf :WaterBody .
:River a owl:Class ; rdfs:label "river" ; rdfs:subClassOf :WaterBody .
:Ocean a owl:Class ; rdfs:label "ocean" ; rdfs:subClassOf :WaterBody .
:Tomato a owl:Class ; rdfs:label "tomato" ; rdfs:subClassOf :WaterBody .
:Sea a owl:Class ; rdfs:label "sea" ; rdfs:subClassOf :Ocean .
:Bay a owl:Class ; rdfs:label "bay" ; rdfs:subClassOf :Ocean .
:Mountain a owl:Class ; rdfs:label "Mountain" ; rdfs:subClassOf :Landform .
